---
title: Monitoring & Observability
---
flowchart LR
    %% Monitoring and Observability Pipeline based on actual codebase

    %% Monitored Components
    subgraph Components["Monitored Components"]
        direction TB
        FastAPI["FastAPI Service"]
        ModelRegistry["Model Registry"]
        DockerContainers["Docker Containers"]
    end

    %% Airflow Monitoring DAG
    subgraph AirflowMonitoring["Airflow Monitoring DAG"]
        direction TB
        MonitoringDAG["Monitoring DAG (30min schedule)"]
        APIHealth["API Health Check"]
        ResourceMonitor["System Resource Monitor"]
        ModelPerformance["Model Performance Tracker"]
        LogAnalyzer["API Log Analyzer"]
    end

    %% Metrics Collection
    subgraph MetricsCollection["Metrics Collection"]
        direction TB
        APIMetrics["API Metrics"]
        ModelMetrics["Model Metrics"]
        SystemMetrics["System Metrics"]
        LogMetrics["Log Analysis Metrics"]
        Pushgateway["Prometheus Pushgateway"]
    end 

    %% Prometheus & Grafana
    subgraph MonitoringInfra["Monitoring Infrastructure"]
        direction TB
        Prometheus["Prometheus"]
        Grafana["Grafana Dashboards"]
    end

    %% Component to monitoring relationships
    FastAPI -->|health endpoint| APIHealth
    FastAPI -->|generates| LogMetrics
    ModelRegistry -->|evaluation results| ModelPerformance
    DockerContainers -->|resource usage| ResourceMonitor

    %% Airflow DAG relationships
    MonitoringDAG -->|executes| APIHealth
    MonitoringDAG -->|executes| ResourceMonitor
    MonitoringDAG -->|executes| ModelPerformance
    MonitoringDAG -->|executes| LogAnalyzer

    %% Metrics flow
    APIHealth -->|api_health_check job| Pushgateway
    ResourceMonitor -->|system_resources job| Pushgateway
    ModelPerformance -->|model_performance_monitoring job| Pushgateway
    LogAnalyzer -->|api_log_analysis job| Pushgateway

    %% Prometheus & Grafana
    Pushgateway -->|scrapes| Prometheus
    Prometheus -->|visualizes| Grafana
    
    %% Docker Compose
    DockerComposeMonitoring["Docker Compose Monitoring"]
    DockerComposeMonitoring -->|configures| MonitoringInfra
    DockerComposeMonitoring -->|configures| Pushgateway

    %% Styling
    classDef components fill:#6baed6,stroke:#2171b5,stroke-width:2px,color:white
    classDef airflow fill:#2ca02c,stroke:#217821,stroke-width:2px,color:white
    classDef metrics fill:#1a9850,stroke:#0d5e2e,stroke-width:2px,color:white
    classDef monitoring fill:#d62728,stroke:#a50f15,stroke-width:2px,color:white
    classDef orchestration fill:#31a354,stroke:#006d2c,stroke-width:2px,color:white

    %% Apply styles
    class FastAPI,ModelRegistry,DockerContainers components
    class MonitoringDAG,APIHealth,ResourceMonitor,ModelPerformance,LogAnalyzer airflow
    class APIMetrics,ModelMetrics,SystemMetrics,LogMetrics,Pushgateway metrics
    class Prometheus,Grafana monitoring
    class DockerComposeMonitoring orchestration